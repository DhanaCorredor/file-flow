#!/bin/sh
# Refuse the commit unless it passes the same gates CI enforces.
# Enable once per clone with: git config core.hooksPath .githooks
#
# Deliberately a plain shell script rather than the pre-commit framework:
# no extra dependency, and it runs the exact commands CI runs.

# Prefer the project virtualenv so the hook works without an activated shell.
if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    PYTHON="python"
    echo "pre-commit: no .venv found, falling back to the system python." >&2
    echo "  A gate failing on a missing tool means: pip install -e \".[dev]\"" >&2
fi

# The gates read the working tree, not the index, so a partial commit gets checked
# against more than it actually contains. Surface that instead of hiding it.
if ! git diff --quiet; then
    echo "pre-commit: unstaged changes present; the gates check the working tree," >&2
    echo "  which is not exactly what this commit contains." >&2
fi

fail() {
    echo "pre-commit: $1 failed. Fix it, or bypass with --no-verify." >&2
    exit 1
}

echo "pre-commit: running quality gates"

"$PYTHON" -m ruff check . || fail "lint"
"$PYTHON" -m ruff format --check . || fail "format check"
"$PYTHON" -m mypy fileflow || fail "type check"
"$PYTHON" -m pytest -q || fail "tests"

echo "pre-commit: all gates passed"
